// A 320x240 thermostat panel for small SPI/RGB displays.

export component Thermostat {
    width: 320px;
    height: 240px;

    in property <float> current: 21.5;
    in-out property <float> target: 22;
    in-out property <bool> eco;
    out property <bool> heating: current < target - 0.4;

    Rectangle { background: #0f172a; }
    VerticalLayout {
        padding: 14px;
        spacing: 6px;
        Text { text: "Living room"; color: #94a3b8; font-size: 14px; }
        HorizontalLayout {
            Text {
                text: round(current * 10) / 10 + "°";
                font-size: 56px;
                color: #f8fafc;
            }
            Text {
                text: heating ? "Heating" : "Idle";
                color: heating ? #fb923c : #64748b;
                horizontal-alignment: right;
                vertical-alignment: center;
                font-size: 16px;
            }
        }
        Text { text: "Target \{target}°"; color: #cbd5e1; font-size: 18px; }
        HorizontalLayout {
            spacing: 10px;
            down := Button { text: "-"; clicked => { target -= 0.5; } }
            Slider { value <=> root.target; minimum: 15; maximum: 28; step: 0.5; }
            up := Button { text: "+"; primary: true; clicked => { target += 0.5; } }
        }
        Rectangle {
            border-radius: 8px;
            background: #1e293b;
            HorizontalLayout {
                padding: 10px;
                CheckBox { text: "Eco mode"; checked <=> root.eco; color: #e2e8f0; }
            }
        }
    }
}
