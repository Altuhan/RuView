// The classic counter, with logic split between .ui and Rust.

export component Counter inherits Window {
    title: "Kite Counter";
    width: 320px;
    height: 200px;

    in-out property <int> counter: 0;
    in property <int> step: 1;
    out property <bool> at-limit: counter >= 10;

    // Implemented in Rust (see main.rs).
    callback request-increase;

    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        alignment: center;

        count := Text {
            text: counter;
            font-size: 48px;
            horizontal-alignment: center;
            color: root.at-limit ? #dc2626 : #111827;
        }
        Text {
            text: root.at-limit ? "Limit reached" : "Step: \{step}";
            horizontal-alignment: center;
            color: #6b7280;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: center;
            minus := Button { text: "-"; enabled: counter > 0; clicked => { counter -= step; } }
            reset := Button { text: "Reset"; clicked => { counter = 0; } }
            plus := Button {
                text: "+";
                primary: true;
                enabled: !root.at-limit;
                clicked => { root.request-increase(); }
            }
        }
    }
}
